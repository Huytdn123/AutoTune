# =========================================================================
# VIRTUAL TUNE - Frontend Environment Configuration
# =========================================================================

# In local development:
# Leave empty or omit to use Vite's built-in local proxy (/api -> http://localhost:10000)
# VITE_API_BASE_URL=

# In production (Vercel):
# Set to your live Render backend URL:
# VITE_API_BASE_URL=https://<your-render-app-name>.onrender.com

