# =========================================================================
# VIRTUAL TUNE - Root .gitignore
# =========================================================================

# OS & Environment Files
.DS_Store
Thumbs.db
*.bak
*.tmp
*.log
.env
.env.local
.env.*.local

# IDEs & Editors
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Java / Maven (Backend)
backend/target/
backend/*.class
backend/*.jar
backend/*.war
backend/.project
backend/.classpath
backend/.settings/

# Node / Vite / React (Frontend)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database Local Backups
database/*.mdf
database/*.ldf
database/*.bak
